generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AcademicLevel {
  SS1
  SS2
  SS3
  JAMB
  L100
  L200
  L300
  L400
  POSTGRAD
}

enum ExamType {
  JAMB
  WAEC
  NECO
  POST_UTME
}

enum Track {
  HIGH_SCHOOL
  UNDERGRAD
  RESEARCHER
}

enum CareerCategory {
  MEDICINE
  ENGINEERING
  DATA_SCIENCE
  LAW
  BUSINESS
  ARTS_HUMANITIES
  EDUCATION
  TECHNOLOGY
}

enum OpportunityType {
  SCHOLARSHIP
  FELLOWSHIP
  COMPETITION
  INTERNSHIP
}

enum ApplicationStatus {
  RESEARCHING
  APPLYING
  SUBMITTED
  ADMITTED
  REJECTED
}

enum ResearchRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model Profile {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  email         String         @unique
  fullName      String?
  track         Track?
  level         AcademicLevel?
  school        String?
  targetExam    ExamType?
  courseOfStudy String?
  researchArea  String?
  researchStage String?
  onboarded     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cbtSessions            CbtSession[]
  coachSessions          CoachSession[]
  careerResults          CareerResult[]
  universityApplications UniversityApplication[]
  researchRequests       ResearchRequest[]
  researchOffers         ResearchOffer[]

  @@map("profiles")
}

model Question {
  id          String   @id @default(cuid())
  examType    ExamType
  subject     String
  year        Int?
  question    String
  options     Json
  answer      String
  explanation String?
  createdAt   DateTime @default(now())

  @@index([examType, subject])
  @@map("questions")
}

model CbtSession {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  examType    ExamType
  subject     String
  score       Int
  total       Int
  answers     Json
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([profileId])
  @@map("cbt_sessions")
}

model CoachSession {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  Json     @default("[]")
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("coach_sessions")
}

model CareerResult {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers    Json
  topMatches Json
  createdAt  DateTime @default(now())

  @@index([profileId])
  @@map("career_results")
}

model Opportunity {
  id          String          @id @default(cuid())
  title       String
  provider    String
  type        OpportunityType
  category    CareerCategory?
  description String
  eligibility String?
  deadline    DateTime?
  link        String
  level       AcademicLevel?
  createdAt   DateTime        @default(now())

  @@index([type])
  @@map("opportunities")
}

model UniversityProgram {
  id           String   @id @default(cuid())
  name         String
  country      String
  program      String
  requirements String?
  link         String?
  createdAt    DateTime @default(now())

  @@map("university_programs")
}

model UniversityApplication {
  id             String            @id @default(cuid())
  profileId      String
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  universityName String
  country        String
  program        String
  status         ApplicationStatus @default(RESEARCHING)
  deadline       DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([profileId])
  @@map("university_applications")
}

model ResearchRequest {
  id           String                @id @default(cuid())
  profileId    String
  profile      Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String
  skillsNeeded String?
  budget       String?
  status       ResearchRequestStatus @default(OPEN)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  offers ResearchOffer[]

  @@index([profileId])
  @@map("research_requests")
}

model ResearchOffer {
  id        String          @id @default(cuid())
  requestId String
  request   ResearchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@index([profileId])
  @@map("research_offers")
}
