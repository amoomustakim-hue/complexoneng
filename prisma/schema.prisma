generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AcademicLevel {
  SS1
  SS2
  SS3
  JAMB
  L100
  L200
  L300
  L400
  POSTGRAD
}

enum ExamType {
  JAMB
  WAEC
  NECO
  POST_UTME
}

enum Track {
  HIGH_SCHOOL
  UNDERGRAD
  RESEARCHER
}

enum CareerCategory {
  MEDICINE
  ENGINEERING
  DATA_SCIENCE
  LAW
  BUSINESS
  ARTS_HUMANITIES
  EDUCATION
  TECHNOLOGY
}

enum OpportunityType {
  SCHOLARSHIP
  FELLOWSHIP
  COMPETITION
  INTERNSHIP
}

enum ApplicationStatus {
  RESEARCHING
  APPLYING
  SUBMITTED
  ADMITTED
  REJECTED
}

enum ResearchRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum InventoryCategory {
  TEXTBOOK
  LAPTOP
  ACADEMIC_MATERIAL
}

enum HostelType {
  OWNED
  PARTNER
}

enum OrderItemType {
  INVENTORY
  HOSTEL
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum CommunityCategory {
  JAMB_CANDIDATES
  UNIVERSITY_STUDENTS
  SUBJECT_ENTHUSIASTS
  ENTREPRENEURS
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ContentType {
  TEXT
  VIDEO
}

model Profile {
  id              String         @id @default(cuid())
  clerkUserId     String         @unique
  email           String         @unique
  fullName        String?
  track           Track?
  level           AcademicLevel?
  school          String?
  targetExam      ExamType?
  courseOfStudy   String?
  researchArea    String?
  researchStage   String?
  isAdmin         Boolean        @default(false)
  isMentor        Boolean        @default(false)
  mentorBio       String?
  mentorExpertise String?
  portfolioSlug   String?        @unique
  portfolioPublic Boolean        @default(false)
  onboarded       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cbtSessions            CbtSession[]
  coachSessions          CoachSession[]
  careerResults          CareerResult[]
  universityApplications UniversityApplication[]
  researchRequests       ResearchRequest[]
  researchOffers         ResearchOffer[]
  orders                 Order[]
  communityMemberships   CommunityMembership[]
  communityPosts         CommunityPost[]
  mentorshipRequestsSent MentorshipRequest[]      @relation("MentorshipStudent")
  mentorshipRequestsRecv MentorshipRequest[]      @relation("MentorshipMentor")
  certificates           Certificate[]
  projects               Project[]
  volunteering           VolunteeringExperience[]
  researchOutputs        ResearchOutput[]
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  moduleQuizAttempts     ModuleQuizAttempt[]
  courseReviews          CourseReview[]
  courseCertificates     CourseCertificate[]
  lessonNotes            LessonNote[]
  lessonQuestions        LessonQuestion[]
  lessonAnswers          LessonAnswer[]

  @@map("profiles")
}

model Question {
  id          String   @id @default(cuid())
  examType    ExamType
  subject     String
  year        Int?
  question    String
  options     Json
  answer      String
  explanation String?
  createdAt   DateTime @default(now())

  @@index([examType, subject])
  @@map("questions")
}

model CbtSession {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  examType    ExamType
  subject     String
  score       Int
  total       Int
  answers     Json
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([profileId])
  @@map("cbt_sessions")
}

model CoachSession {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  Json     @default("[]")
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("coach_sessions")
}

model CareerResult {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers    Json
  topMatches Json
  createdAt  DateTime @default(now())

  @@index([profileId])
  @@map("career_results")
}

model Opportunity {
  id          String          @id @default(cuid())
  title       String
  provider    String
  type        OpportunityType
  category    CareerCategory?
  description String
  eligibility String?
  deadline    DateTime?
  link        String
  level       AcademicLevel?
  createdAt   DateTime        @default(now())

  @@index([type])
  @@map("opportunities")
}

model UniversityProgram {
  id           String   @id @default(cuid())
  name         String
  country      String
  program      String
  requirements String?
  link         String?
  createdAt    DateTime @default(now())

  @@map("university_programs")
}

model UniversityApplication {
  id             String            @id @default(cuid())
  profileId      String
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  universityName String
  country        String
  program        String
  status         ApplicationStatus @default(RESEARCHING)
  deadline       DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([profileId])
  @@map("university_applications")
}

model ResearchRequest {
  id           String                @id @default(cuid())
  profileId    String
  profile      Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String
  skillsNeeded String?
  budget       String?
  status       ResearchRequestStatus @default(OPEN)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  offers ResearchOffer[]

  @@index([profileId])
  @@map("research_requests")
}

model ResearchOffer {
  id        String          @id @default(cuid())
  requestId String
  request   ResearchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@index([profileId])
  @@map("research_offers")
}

model InventoryItem {
  id          String            @id @default(cuid())
  name        String
  category    InventoryCategory
  price       Int
  stock       Int               @default(0)
  condition   String?
  format      String?
  description String?
  imageUrls   Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category])
  @@map("inventory_items")
}

model Hostel {
  id             String     @id @default(cuid())
  name           String
  type           HostelType
  area           String
  pricePerYear   Int
  deposit        Int
  roomsAvailable Int        @default(0)
  amenities      Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([area])
  @@map("hostels")
}

model Order {
  id           String        @id @default(cuid())
  profileId    String?
  profile      Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  studentPhone String?
  itemType     OrderItemType
  itemId       String
  itemName     String
  amount       Int
  paystackRef  String?       @unique
  status       OrderStatus   @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([profileId])
  @@index([status])
  @@map("orders")
}

model WaSession {
  phone     String   @id
  state     String   @default("idle")
  context   Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("wa_sessions")
}

model Community {
  id          String            @id @default(cuid())
  name        String
  category    CommunityCategory
  description String
  createdAt   DateTime          @default(now())

  memberships CommunityMembership[]
  posts       CommunityPost[]

  @@index([category])
  @@map("communities")
}

model CommunityMembership {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([communityId, profileId])
  @@index([profileId])
  @@map("community_memberships")
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())

  @@index([communityId])
  @@map("community_posts")
}

model MentorshipRequest {
  id             String           @id @default(cuid())
  mentorId       String
  mentor         Profile          @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId      String
  student        Profile          @relation("MentorshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  message        String
  preferredTopic String?
  status         MentorshipStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([mentorId])
  @@index([studentId])
  @@map("mentorship_requests")
}

model Certificate {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String
  issuer     String
  dateIssued DateTime?
  link       String?
  createdAt  DateTime  @default(now())

  @@index([profileId])
  @@map("certificates")
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  link        String?
  createdAt   DateTime @default(now())

  @@index([profileId])
  @@map("projects")
}

model VolunteeringExperience {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization String
  role         String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  @@index([profileId])
  @@map("volunteering_experiences")
}

model ResearchOutput {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  link        String?
  createdAt   DateTime @default(now())

  @@index([profileId])
  @@map("research_outputs")
}

model Course {
  id          String   @id @default(cuid())
  subject     String
  title       String
  levelTag    String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  modules      Module[]
  enrollments  Enrollment[]
  reviews      CourseReview[]
  certificates CourseCertificate[]

  @@index([subject])
  @@map("courses")
}

model Module {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  order         Int      @default(0)
  quizQuestions Json?
  createdAt     DateTime @default(now())

  lessons      Lesson[]
  quizAttempts ModuleQuizAttempt[]

  @@index([courseId])
  @@map("course_modules")
}

model ModuleQuizAttempt {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  answers   Json
  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([moduleId])
  @@map("module_quiz_attempts")
}

model Lesson {
  id          String      @id @default(cuid())
  moduleId    String
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  order       Int         @default(0)
  contentType ContentType @default(TEXT)
  textContent String?
  videoUrl    String?
  createdAt   DateTime    @default(now())

  progress  LessonProgress[]
  notes     LessonNote[]
  questions LessonQuestion[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([profileId, courseId])
  @@index([profileId])
  @@map("enrollments")
}

model LessonProgress {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([profileId, lessonId])
  @@index([profileId])
  @@map("lesson_progress")
}

model CourseReview {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, courseId])
  @@index([courseId])
  @@map("course_reviews")
}

model CourseCertificate {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateSlug String   @unique
  issuedAt        DateTime @default(now())

  @@unique([profileId, courseId])
  @@map("course_certificates")
}

model LessonNote {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, lessonId])
  @@index([profileId])
  @@map("lesson_notes")
}

model LessonQuestion {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  answers LessonAnswer[]

  @@index([lessonId])
  @@map("lesson_questions")
}

model LessonAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content    String
  isBest     Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([questionId])
  @@map("lesson_answers")
}
