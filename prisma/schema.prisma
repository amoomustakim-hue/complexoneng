generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AcademicLevel {
  SS1
  SS2
  SS3
  JAMB
  L100
  L200
  L300
  L400
  POSTGRAD
}

enum ExamType {
  JAMB
  WAEC
  NECO
  POST_UTME
}

enum Track {
  HIGH_SCHOOL
  UNDERGRAD
  RESEARCHER
}

model Profile {
  id             String         @id @default(cuid())
  clerkUserId    String         @unique
  email          String         @unique
  fullName       String?
  track          Track?
  level          AcademicLevel?
  school         String?
  targetExam     ExamType?
  courseOfStudy  String?
  researchArea   String?
  researchStage  String?
  onboarded      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cbtSessions   CbtSession[]
  coachSessions CoachSession[]

  @@map("profiles")
}

model Question {
  id          String   @id @default(cuid())
  examType    ExamType
  subject     String
  year        Int?
  question    String
  options     Json
  answer      String
  explanation String?
  createdAt   DateTime @default(now())

  @@index([examType, subject])
  @@map("questions")
}

model CbtSession {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  examType    ExamType
  subject     String
  score       Int
  total       Int
  answers     Json
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([profileId])
  @@map("cbt_sessions")
}

model CoachSession {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages  Json     @default("[]")
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("coach_sessions")
}
